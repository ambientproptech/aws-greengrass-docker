ARG BASE_IMAGE=greengrass-base:local

# --- Builder: compile native extensions, install pip packages ---
FROM ${BASE_IMAGE} AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-dev \
    cmake \
    build-essential \
    libssl-dev \
    zlib1g-dev \
    pkg-config \
    && python3 -m pip install --no-cache-dir --break-system-packages awsiotsdk boto3 botocore \
    && apt-get purge -y cmake build-essential python3-dev pkg-config libssl-dev zlib1g-dev \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# --- Final: only the pip-installed packages are carried forward ---
FROM ${BASE_IMAGE}

COPY --from=builder /usr/local/lib/python3.11/dist-packages /usr/local/lib/python3.11/dist-packages

LABEL org.opencontainers.image.description="Greengrass release image (extends Dockerfile base)"
