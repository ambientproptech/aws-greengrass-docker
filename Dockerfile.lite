#
# Greengrass Nucleus Lite + IoT SDK. Compile in `build`, ship `release`.
# https://docs.aws.amazon.com/greengrass/v2/developerguide/greengrass-nucleus-lite-component.html
#
#   docker build -f Dockerfile.lite --target release \
#     --build-arg GREENGRASS_RELEASE_VERSION=2.6.0 \
#     --build-arg NUCLEUS_LITE_SOURCE_TAG=v2.6.0 .

# -----------------------------------------------------------------------------
# build — toolchain, source, compile (not published)
# -----------------------------------------------------------------------------
FROM debian:bookworm-slim AS build

ARG NUCLEUS_LITE_SOURCE_TAG=v2.6.0
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    build-essential \
    pkg-config \
    cmake \
    git \
    curl \
    libssl-dev \
    libcurl4-openssl-dev \
    uuid-dev \
    libzip-dev \
    libsqlite3-dev \
    libyaml-dev \
    libsystemd-dev \
    libevent-dev \
    liburiparser-dev \
    cgroup-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN curl -fsSL \
      "https://codeload.github.com/aws-greengrass/aws-greengrass-lite/tar.gz/refs/tags/${NUCLEUS_LITE_SOURCE_TAG}" \
    | tar -xz --strip-components=1

RUN --mount=type=cache,target=/src/build/_deps,sharing=locked \
    cmake -B build \
      -DCMAKE_BUILD_TYPE=MinSizeRel \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DGGL_SYSTEMD_SYSTEM_USER=ggcore \
      -DGGL_SYSTEMD_SYSTEM_GROUP=ggcore \
      -DGGL_SYSTEMD_SYSTEM_DIR=/lib/systemd/system \
    || { cat build/CMakeFiles/CMakeError.log 2>/dev/null; exit 1; } \
    && make -C build -j"$(nproc)" \
    && DESTDIR=/install make -C build install

# -----------------------------------------------------------------------------
# release — runtime image (published)
# -----------------------------------------------------------------------------
FROM debian:bookworm-slim AS release

ARG GREENGRASS_RELEASE_VERSION=2.6.0
ARG NUCLEUS_LITE_SOURCE_TAG=v2.6.0
ENV DEBIAN_FRONTEND=noninteractive

LABEL maintainer="AWS IoT Greengrass"
LABEL gg.nucleus.runtime="lite"
LABEL greengrass-version=${GREENGRASS_RELEASE_VERSION}
LABEL greengrass-nucleus-lite-source-tag=${NUCLEUS_LITE_SOURCE_TAG}
LABEL gg.base.os="debian-bookworm-slim"
LABEL gg.requirements.doc="https://docs.aws.amazon.com/greengrass//developerguide/greengrass-nucleus-lite-component.html"
LABEL gg.podman.doc="https://github.com/aws-greengrass/aws-greengrass-lite/blob/main/docs/BUILD.md#optional-using-podman"
LABEL org.opencontainers.image.description="Greengrass lite image (nucleus lite + IoT SDK / boto3)"

ENV TINI_KILL_PROCESS_GROUP=1 \
    GGC_ROOT_PATH=/var/lib/greengrass \
    GG_NUCLEUS_RUNTIME=lite \
    INIT_CONFIG=/greengrass/config/config.yaml

RUN apt-get update && apt-get install -y --no-install-recommends \
    systemd \
    systemd-sysv \
    dbus \
    ca-certificates \
    curl \
    wget \
    sudo \
    procps \
    passwd \
    python3 \
    python3-pip \
    coreutils \
    grep \
    util-linux \
    bash \
    debianutils \
    mount \
    libssl3 \
    libcurl4 \
    libsqlite3-0 \
    libyaml-0-2 \
    libsystemd0 \
    liburiparser1 \
    libuuid1 \
    libevent-2.1-7 \
    libzip4 \
    cgroup-tools \
    logrotate \
    && rm -rf /var/lib/apt/lists/* \
    && for c in ps sudo sh kill cp chmod rm ln id uname grep mkfifo findmnt useradd groupadd usermod echo systemctl; do \
         command -v "$c" >/dev/null || exit 1; \
       done

RUN groupadd -r ggcore \
    && useradd -r -g ggcore -d /var/lib/greengrass ggcore \
    && groupadd -r gg_component \
    && useradd -r -g gg_component gg_component \
    && mkdir -p /var/lib/greengrass/credentials /etc/greengrass/config.d \
    && chown -R ggcore:ggcore /var/lib/greengrass

COPY --from=build /install/usr/bin/ /usr/bin/
COPY --from=build /install/lib/systemd/system/ /lib/systemd/system/
COPY --from=build /install/usr/lib/tmpfiles.d/ /usr/lib/tmpfiles.d/
COPY --from=build /src/misc/container/01defaults.yaml /etc/greengrass/config.d/01defaults.yaml
COPY scripts/ggl-start-nucleus.sh /usr/local/bin/ggl-start-nucleus
COPY scripts/ggl-reconcile-component-units.sh /usr/local/bin/ggl-reconcile-component-units
COPY scripts/ggl-ensure-unit-log-dir.sh /usr/local/bin/ggl-ensure-unit-log-dir
COPY scripts/ggl-install-unit-logging.sh /usr/local/bin/ggl-install-unit-logging
COPY scripts/ggl-bake-systemd-enables.sh /tmp/ggl-bake-systemd-enables.sh
COPY config/systemd/system.conf.d/greengrass-component-units.conf \
  /etc/systemd/system.conf.d/greengrass-component-units.conf
COPY config/journald.conf.d/ /etc/systemd/journald.conf.d/
COPY config/logrotate.d/greengrass-systemd /etc/logrotate.d/greengrass-systemd

COPY ggl-container-init.service /lib/systemd/system/ggl-container-init.service
COPY greengrass-lite-entrypoint.sh /greengrass-lite-entrypoint.sh
COPY modify-sudoers.sh /
RUN chmod +x /usr/local/bin/ggl-start-nucleus /usr/local/bin/ggl-reconcile-component-units \
    /usr/local/bin/ggl-ensure-unit-log-dir /usr/local/bin/ggl-install-unit-logging \
    /greengrass-lite-entrypoint.sh /modify-sudoers.sh \
    && ./modify-sudoers.sh \
    && chmod +x /tmp/ggl-bake-systemd-enables.sh \
    && /tmp/ggl-bake-systemd-enables.sh \
    && rm /tmp/ggl-bake-systemd-enables.sh \
    && ln -sf /lib/systemd/system/ggl-container-init.service \
         /etc/systemd/system/multi-user.target.wants/ggl-container-init.service \
    && ln -sf /lib/systemd/system/logrotate.timer \
         /etc/systemd/system/timers.target.wants/logrotate.timer

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-dev \
    cmake \
    build-essential \
    libssl-dev \
    zlib1g-dev \
    pkg-config \
    && python3 -m pip install --no-cache-dir --break-system-packages awsiotsdk boto3 botocore \
    && apt-get purge -y cmake build-essential python3-dev pkg-config libssl-dev zlib1g-dev \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/greengrass-lite-entrypoint.sh"]
CMD ["/lib/systemd/systemd"]
