#
# Shared IoT SDK layer for full and lite images. Build on top of a base image:
#   docker build -f Dockerfile.sdk --build-arg BASE_IMAGE=<base-full-or-lite> .

ARG BASE_IMAGE=greengrass-base:local
ARG NUCLEUS_FLAVOUR=full

FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-dev \
    cmake \
    build-essential \
    libssl-dev \
    zlib1g-dev \
    pkg-config \
    && python3 -m pip install --no-cache-dir --break-system-packages awsiotsdk boto3 botocore \
    && apt-get purge -y cmake build-essential python3-dev pkg-config libssl-dev zlib1g-dev \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

LABEL org.opencontainers.image.description="Greengrass ${NUCLEUS_FLAVOUR} image with IoT SDK / boto3"
